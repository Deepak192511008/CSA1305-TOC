
#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int len;

    printf("Enter a string: ");
    scanf("%99s", str);

    len = strlen(str);

    if (len >= 2 && str[0] == '0' && str[len - 1] == '1')
        printf("String is accepted by NFA");
    else
        printf("String is rejected by NFA");

    return 0;
}
